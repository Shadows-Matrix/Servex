# ---- Database ----
# PostgreSQL connection string (Neon, Supabase, or Vercel Postgres)
# Neon example:
# DATABASE_URL="postgresql://user:password@ep-xxx-123456.us-east-2.aws.neon.tech/servex?sslmode=require"
DATABASE_URL="postgresql://user:password@localhost:5432/servex?schema=public"

# ---- Auth.js v5 ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Set to your production URL on Vercel (https://your-app.vercel.app)
AUTH_URL="http://localhost:3000"

# ---- Cloudinary (optional for MVP) ----
# Uploads degrade gracefully to placeholder images when unset.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- SMTP email (real OTP delivery) ----
# Gmail (recommended): use an App password, NOT your normal Gmail password.
# Google Account → Security → 2-Step Verification → App passwords → generate one,
# then paste the 16-character code below (spaces optional).
# When unset, OTP codes are logged to the server console + shown on screen (dev only).
# In production a missing SMTP means users never receive a code — requests still
# succeed but there is nothing to deliver, so always configure this in prod.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS=""
SMTP_FROM="SERVEX <you@gmail.com>"
